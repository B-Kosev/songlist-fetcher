# Example Streamlit secrets — copy to `.streamlit/secrets.toml` (never commit real values).
#
# Generate passcode hashes:
#   python -c "import hashlib; print(hashlib.sha256(b'YOUR_PASSCODE').hexdigest())"

team_passcode_hash = "replace-with-sha256-hex-of-team-passcode"
admin_passcode_hash = "replace-with-sha256-hex-of-admin-passcode"

[supabase]
url = "https://YOUR_PROJECT.supabase.co"
key = "YOUR_SUPABASE_ANON_OR_SERVICE_KEY"
